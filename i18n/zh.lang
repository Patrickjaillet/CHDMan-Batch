LANG_NAME=简体中文
LANG_CODE=zh

; ==== Language selector ====
LANGSEL_TITLE=CHDMAN TOOL - 语言选择
LANGSEL_PROMPT=请选择语言 / Choose your language :
LANGSEL_1=[1] English
LANGSEL_2=[2] Francais
LANGSEL_3=[3] Deutsch
LANGSEL_4=[4] Espanol
LANGSEL_5=[5] 日本語
LANGSEL_6=[6] 简体中文
LANGSEL_CHOICE=您的选择 (1-6)：
LANGSEL_INVALID=无效选择。

; ==== Startup errors ====
ERR_CHDMAN_MISSING=[错误] 在此文件夹中未找到 chdman.exe：
ERR_CHDMAN_MISSING_HINT=请将 CHDMAN_Tool.bat 与 chdman.exe 放在同一文件夹中

; ==== Main menu ====
MENU_TITLE=CHDMAN TOOL - 菜单
MENU_LANG_LABEL=语言
MENU_1=[1] 从单个文件创建 CHD (CUE / GDI / ISO)
MENU_2=[2] 批量创建 CHD (整个文件夹及子文件夹)
MENU_3=[3] 提取 CHD (CUE+BIN、GDI 或 ISO)
MENU_4=[4] 批量提取 CHD (整个文件夹)
MENU_5=[5] 验证 CHD 的完整性
MENU_6=[6] 显示 CHD 信息
MENU_7=[7] 压缩硬盘镜像 (createhd / createraw)
MENU_8=[8] 更改语言
MENU_9=[9] 退出
MENU_CHOICE=您的选择 (1-9)：
MENU_INVALID=无效选择。

; ==== Common prompts ====
PROMPT_DROP_FILE_CUE=请将 .cue、.gdi 或 .iso 文件拖放到此处，
PROMPT_DROP_FILE_CHD=请将 .chd 文件拖放到此处，
PROMPT_DROP_FILE_HD=请将镜像文件 (.img、.raw、.hdd 等) 拖放到此处，
PROMPT_DROP_FOLDER=请将要扫描的根文件夹拖放到此处，
PROMPT_THEN_ENTER=然后按 Enter 键 (或输入完整路径)：
PROMPT_SOURCE_FILE=源文件：
PROMPT_SOURCE_FOLDER=源文件夹：
PROMPT_CHD_FILE=.chd 文件：
ERR_FILE_NOT_FOUND=[错误] 未找到文件：
ERR_FOLDER_NOT_FOUND=[错误] 未找到文件夹：

; ==== 1) Create - single file ====
CREATE_SINGLE_TITLE=创建 CHD - 单个文件
DISK_TYPE_PROMPT=光盘类型：
DISK_TYPE_CD=[1] CD (CUE/GDI - PSX、Saturn、世嘉CD、Dreamcast...)
DISK_TYPE_DVD=[2] DVD (ISO - GameCube、PS2、Xbox...)
DISK_TYPE_CHOICE=选择 (1-2)：
COMMAND_LABEL=命令：
CREATE_OK=[OK] CHD 已创建：
CREATE_FAILED=[警告] 转换似乎已失败。

; ==== 2) Create - batch ====
CREATE_BATCH_TITLE=批量创建 CHD
BATCH_TYPE_PROMPT=要处理的光盘类型：
BATCH_TYPE_CD=[1] 仅 CD  (*.cue, *.gdi)          -> createcd
BATCH_TYPE_DVD=[2] 仅 DVD (*.iso)                 -> createdvd
BATCH_TYPE_BOTH=[3] 两者都要 (CUE/GDI 作为 CD，ISO 作为 DVD)
BATCH_TYPE_CHOICE=选择 (1-3)：
BATCH_DONE=完成。已转换文件数：
BATCH_FAILURES=失败数：
BATCH_CD_LABEL=-> CD  :
BATCH_DVD_LABEL=-> DVD :

; ==== 3) Extract - single file ====
EXTRACT_SINGLE_TITLE=提取 CHD - 单个文件
OUTPUT_FORMAT_PROMPT=输出格式：
OUTPUT_FORMAT_CUEBIN=[1] CUE + BIN  (CD - PSX、Saturn、世嘉CD...)
OUTPUT_FORMAT_GDI=[2] GDI        (Dreamcast)
OUTPUT_FORMAT_ISO=[3] ISO        (DVD)
OUTPUT_FORMAT_CHOICE=选择 (1-3)：
EXTRACT_OK=[OK] 提取完成：
EXTRACT_FAILED=[警告] 提取似乎已失败。

; ==== 4) Extract - batch ====
EXTRACT_BATCH_TITLE=批量提取 CHD
BATCH_OUTPUT_FORMAT_PROMPT=所有找到的 CHD 文件的输出格式：
BATCH_DONE_EXTRACT=完成。已提取文件数：
BATCH_EXTRACT_LABEL=->

; ==== 5) Verify ====
VERIFY_TITLE=验证 CHD

; ==== 6) Info ====
INFO_TITLE=CHD 信息

; ==== 7) Create HD ====
CREATE_HD_TITLE=压缩硬盘镜像

; ==== Exit ====
GOODBYE=再见！
